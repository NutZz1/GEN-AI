# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# "anthropic" (default), "ollama", or "none" (forces the rule-based fallback everywhere).
AVATARBLEND_LLM_PROVIDER=anthropic

# --- Anthropic backend ---
ANTHROPIC_API_KEY=
AVATARBLEND_AGENT_MODEL=claude-sonnet-5

# --- Ollama backend (optional, local, no API key) ---
# To use it, set AVATARBLEND_LLM_PROVIDER=ollama above. Needs `ollama serve` running and the model pulled
# (`ollama pull llama3.1`, ~5 GB; an 8B model wants ~6 GB of free RAM or a GPU).
# Tool-calling quality varies a lot by model; the agent degrades to its heuristic planner if the
# model doesn't emit tool calls. Run `python check_llm.py` to test the connection and latency.
AVATARBLEND_OLLAMA_MODEL=llama3.1
# Ollama on this machine:
OLLAMA_HOST=http://localhost:11434
# ...or Ollama on another machine on the same network (e.g. a teammate's GPU laptop). On that machine set the
# environment variable OLLAMA_HOST=0.0.0.0 and restart Ollama, allow port 11434 through the firewall, then here:
# OLLAMA_HOST=http://192.168.x.x:11434
AVATARBLEND_OLLAMA_NUM_CTX=8192       # context window; the parser prompt + tool schemas are ~2-3k tokens
AVATARBLEND_OLLAMA_KEEP_ALIVE=30m     # keep the model loaded between chat turns

# --- Agent tuning ---
AVATARBLEND_AGENT_MAX_TOKENS=1024
AVATARBLEND_AGENT_MAX_RETRIES=3
AVATARBLEND_AGENT_TIMEOUT=60          # seconds per LLM call; the first call may also load the model
