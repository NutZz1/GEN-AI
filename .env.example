# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# "anthropic" (default), "ollama", or "none" (forces the rule-based fallback everywhere).
AVATARBLEND_LLM_PROVIDER=anthropic

# --- Anthropic backend ---
ANTHROPIC_API_KEY=
AVATARBLEND_AGENT_MODEL=claude-sonnet-5

# --- Ollama backend (optional, local, no API key) ---
# Requires `ollama serve` running locally and the model pulled (`ollama pull llama3.1`).
# Tool-calling quality varies a lot by model; the agent degrades to its heuristic planner if the
# model doesn't emit tool calls.
AVATARBLEND_OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434

# --- Agent tuning ---
AVATARBLEND_AGENT_MAX_TOKENS=1024
AVATARBLEND_AGENT_MAX_RETRIES=3
AVATARBLEND_AGENT_TIMEOUT=30
